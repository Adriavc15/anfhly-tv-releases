<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AnfhlyTV" parent="Theme.Leanback">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/background_app</item>
        <item name="android:colorBackground">@drawable/background_app</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.AnfhlyTV.NoActionBar" parent="Theme.Leanback">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="Theme.AnfhlyTV.Fullscreen" parent="Theme.Leanback">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@drawable/background_app</item>
    </style>

    <style name="WhiteBufferingTheme" parent="Theme.Leanback">
        <item name="colorAccent">#FFFFFF</item>
        <item name="android:colorAccent">#FFFFFF</item>
    </style>

    <style name="RoundedDialog" parent="android:Theme.Material.Dialog">
        <item name="android:windowBackground">@drawable/dialog_rounded_background</item>
        <item name="android:windowMinWidthMajor">45%</item>
        <item name="android:windowMinWidthMinor">45%</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:background">#424242</item>
    </style>

</resources>
