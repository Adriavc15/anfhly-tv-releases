<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_controller"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#50000000">

    <!-- Title Container at top -->
    <LinearLayout
        android:id="@+id/ll_title_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:maxWidth="220dp"
            android:layout_marginBottom="8dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:visibility="gone"
            tools:src="@tools:sample/avatars" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="Title" />
        <!-- Subtitle/Description - HIDDEN by default -->
        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Description" />
    </LinearLayout>

    <!-- Bottom Controls Container -->
    <LinearLayout
        android:id="@+id/ll_bottom_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Progress Bar Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.media3.ui.DefaultTimeBar
                android:id="@+id/exo_progress"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusDown="@+id/btn_play_pause"
                app:bar_height="4dp"
                app:touch_target_height="32dp"
                app:played_color="#FFFFFF"
                app:buffered_color="#80FFFFFF"
                app:unplayed_color="#40FFFFFF"
                app:scrubber_color="#FFFFFF"
                app:scrubber_enabled_size="12dp"
                app:scrubber_disabled_size="8dp"
                app:scrubber_dragged_size="16dp" />

            <!-- Time Display -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/exo_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="00:00" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="/"
                    android:textColor="#80FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/exo_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#80FFFFFF"
                    android:textSize="14sp"
                    tools:text="00:00" />
            </LinearLayout>
        </LinearLayout>

        <!-- Controls Row: Audio | Subtitle | Quality | Space | Prev | Rew | Stop | Play/Pause | FFwd | Next | Space | Aspect | PiP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Left: Audio / Subtitle / Quality -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_capsule_transparent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_audio"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusLeft="@+id/btn_audio"
                    android:nextFocusRight="@+id/btn_subtitle"
                    android:nextFocusUp="@+id/exo_progress"
                    android:padding="4dp"
                    android:src="@drawable/pista_de_audio"
                    app:tint="@color/tv_icon_tint"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/btn_subtitle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusLeft="@+id/btn_audio"
                    android:nextFocusRight="@+id/btn_quality"
                    android:nextFocusUp="@+id/exo_progress"
                    android:padding="4dp"
                    android:src="@drawable/subtitle"
                    app:tint="@color/tv_icon_tint"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/btn_quality"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusLeft="@+id/btn_subtitle"
                    android:nextFocusRight="@+id/btn_prev"
                    android:nextFocusUp="@+id/exo_progress"
                    android:padding="4dp"
                    android:src="@drawable/calidad"
                    app:tint="@color/tv_icon_tint"
                    tools:ignore="ContentDescription" />
            </LinearLayout>

            <!-- Spacer 1 -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Center: Playback Controls -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_capsule_transparent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_prev"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusLeft="@+id/btn_quality"
                    android:nextFocusRight="@+id/btn_stop"
                    android:nextFocusUp="@+id/exo_progress"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_media_previous"
                    app:tint="@color/tv_icon_tint"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/exo_rew"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusLeft="@+id/btn_quality"
                    android:nextFocusRight="@+id/btn_stop"
                    android:nextFocusUp="@+id/exo_progress"
                    android:padding="6dp"
                    android:src="@drawable/retroceder"
                    app:tint="@color/tv_icon_tint"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/btn_stop"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusLeft="@+id/btn_prev"
                    android:nextFocusRight="@+id/btn_play_pause"
                    android:nextFocusUp="@+id/exo_progress"
                    android:padding="6dp"
                    android:src="@drawable/stop"
                    app:tint="@color/tv_icon_tint"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/btn_play_pause"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusLeft="@+id/btn_stop"
                    android:nextFocusRight="@+id/btn_next"
                    android:nextFocusUp="@+id/exo_progress"
                    android:padding="6dp"
                    android:src="@drawable/play"
                    app:tint="@color/tv_icon_tint"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/exo_ffwd"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusLeft="@+id/btn_play_pause"
                    android:nextFocusRight="@+id/btn_aspect"
                    android:nextFocusUp="@+id/exo_progress"
                    android:padding="6dp"
                    android:src="@drawable/adelantar"
                    app:tint="@color/tv_icon_tint"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/btn_next"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusLeft="@+id/btn_play_pause"
                    android:nextFocusRight="@+id/btn_aspect"
                    android:nextFocusUp="@+id/exo_progress"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_media_next"
                    app:tint="@color/tv_icon_tint"
                    tools:ignore="ContentDescription" />
            </LinearLayout>

            <!-- Spacer 2 -->
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Right: Aspect Ratio (Zoom) / Picture-in-Picture -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_capsule_transparent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_aspect"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusLeft="@+id/btn_next"
                    android:nextFocusRight="@+id/btn_aspect"
                    android:nextFocusUp="@+id/exo_progress"
                    android:padding="4dp"
                    android:src="@drawable/maximizar"
                    app:tint="@color/tv_icon_tint"
                    tools:ignore="ContentDescription" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
