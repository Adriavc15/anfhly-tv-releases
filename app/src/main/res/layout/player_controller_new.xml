<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_controller"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#98000000">

    <!-- Title and Description at top -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="48dp"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Title" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="48dp"
        android:textColor="#B3FFFFFF"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        tools:text="Description" />

    <!-- Bottom Controls Bar -->
    <LinearLayout
        android:id="@+id/ll_bottom_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="40dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- TimeBar -->
        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/time_bar"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginBottom="20dp"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusUp="@id/btn_play_pause"
            android:nextFocusDown="@id/btn_prev" />

        <!-- Controls Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Time Display -->
            <TextView
                android:id="@+id/tv_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="00:00" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="/"
                android:textColor="#B3FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textSize="16sp"
                tools:text="00:00" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Playback Controls -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btn_prev"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusLeft="@id/btn_aspect"
                    android:nextFocusRight="@id/btn_play_pause"
                    android:nextFocusUp="@id/time_bar"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_media_previous"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/btn_play_pause"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusLeft="@id/btn_prev"
                    android:nextFocusRight="@id/btn_next"
                    android:nextFocusUp="@id/time_bar"
                    android:src="@drawable/play"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/btn_next"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/tv_button_background"
                    android:focusable="true"
                    android:focusableInTouchMode="false"
                    android:nextFocusLeft="@id/btn_play_pause"
                    android:nextFocusRight="@id/btn_aspect"
                    android:nextFocusUp="@id/time_bar"
                    android:padding="12dp"
                    android:src="@android:drawable/ic_media_next"
                    tools:ignore="ContentDescription" />

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Aspect Ratio Button -->
            <ImageView
                android:id="@+id/btn_aspect"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/tv_button_background"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusLeft="@id/btn_next"
                android:nextFocusUp="@id/time_bar"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_crop"
                tools:ignore="ContentDescription" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
